---
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import { createSupabaseAdmin } from "@/lib/supabase/server";
import type { TumorAnalysis } from "@/pages/types/analysis";

const filters = ["All", "Glioma", "No Tumor", "Pituitary", "Meningioma"];

const noTumorDetails = {
  insightTitle: "No Tumor",
  insightSubtitle: "No tumor-like pattern detected by the model",
  description: [
    "The model output is most consistent with the no-tumor class. In this prototype, that means the uploaded image did not show the learned visual patterns associated with glioma, meningioma, or pituitary tumor classes.",
    "This does not rule out every neurological condition or replace a radiology report. Brain tumor symptoms can vary by size, location, and growth rate, so persistent headaches, seizures, vision changes, weakness, balance issues, or cognitive changes still need clinical review.",
  ],
  signsTitle: "Model Interpretation Notes",
  signs: [
    "No learned tumor-class pattern was dominant",
    "Low relative probability for glioma class",
    "Low relative probability for meningioma class",
    "Low relative probability for pituitary class",
    "Result depends on image quality and preprocessing",
    "Clinical symptoms should still guide follow-up",
    "Radiologist interpretation remains the reference standard",
    "Repeat imaging may be needed if symptoms persist",
  ],
  recommendation:
    "Keep the scan result with the patient's clinical record and seek professional interpretation if symptoms are present, worsening, or unexplained. This model should only support triage or educational review.",
  notice:
    "Important: A no-tumor model result is not a medical clearance. It is an AI classification output and should not replace professional medical advice.",
};

const gliomaDetails = {
  insightTitle: "Glioma",
  insightSubtitle: "Tumor-like pattern detected",
  description: [
    "The model output is most consistent with the glioma class. Gliomas are tumors that arise from glial cells or related supportive cells in the brain or spinal cord, and they can vary widely in grade, behavior, and treatment approach.",
    "Clinical evaluation usually depends on MRI interpretation, tumor location, neurologic symptoms, and when appropriate, tissue and molecular testing. Symptoms can include headache, seizure, weakness, speech difficulty, balance problems, or cognitive and behavior changes, but symptoms are not specific to glioma.",
  ],
  signsTitle: "Observed Model Indicators",
  signs: [
    "Tumor-like image texture aligned with glioma class",
    "Abnormal tissue-intensity pattern in learned features",
    "Probability distribution favors glioma over other classes",
    "Glioma class can include different biological subtypes",
    "Tumor grade cannot be determined from this model alone",
    "Location and mass effect require radiology review",
    "Symptoms and clinical history must be correlated",
    "External validation is still required",
  ],
  recommendation:
    "Forward the scan and model output to a radiologist, neurologist, or neurosurgical team for formal interpretation and follow-up planning. Urgent symptoms such as new seizure, sudden weakness, severe worsening headache, or confusion require prompt medical care.",
  notice:
    "Important: This is not a clinical diagnosis. CerebraSense is a research and educational prototype.",
};

const meningiomaDetails = {
  insightTitle: "Meningioma",
  insightSubtitle: "Meningeal tumor-like pattern detected",
  description: [
    "The model output is most consistent with the meningioma class. Meningiomas arise from the meninges, the protective membranes around the brain and spinal cord. Many are slow-growing and benign, but some can cause problems by pressing on nearby brain, nerve, or vascular structures.",
    "Symptoms depend strongly on location and may include headaches, vision changes, hearing changes, seizures, weakness, numbness, or cognitive changes. Some meningiomas are found incidentally and are monitored with repeat imaging rather than treated immediately.",
  ],
  signsTitle: "Observed Model Indicators",
  signs: [
    "Pattern aligns with meningioma class features",
    "Possible extra-axial or border-adjacent visual pattern",
    "Confidence should be checked against MRI sequence quality",
    "Location matters for symptom risk",
    "Slow-growing tumors may be monitored",
    "Mass effect cannot be judged by this classifier alone",
    "Radiology review is needed for confirmation",
    "Treatment decisions depend on size, growth, and symptoms",
  ],
  recommendation:
    "Share the result with a qualified clinician for formal MRI review. If a meningioma is suspected, common next steps may include comparison with prior imaging, monitoring for growth, or referral to neurology/neurosurgery depending on symptoms and location.",
  notice:
    "Important: This model cannot determine whether a meningioma is benign, aggressive, growing, or clinically significant.",
};

const pituitaryDetails = {
  insightTitle: "Pituitary",
  insightSubtitle: "Pituitary-region tumor-like pattern detected",
  description: [
    "The model output is most consistent with the pituitary class. Pituitary tumors usually arise in or near the pituitary gland at the base of the brain. Many are adenomas and are not cancer, but they can affect vision, nearby structures, or hormone production.",
    "Pituitary tumors may cause symptoms from pressure, such as headache or vision changes, or from hormone imbalance, such as menstrual changes, sexual dysfunction, fatigue, unexplained weight changes, growth changes, or symptoms related to thyroid or adrenal hormone disruption.",
  ],
  signsTitle: "Observed Model Indicators",
  signs: [
    "Pattern aligns with pituitary class features",
    "Possible sellar or pituitary-region visual pattern",
    "Hormone function cannot be assessed from image classification",
    "Visual pathway involvement needs clinical assessment",
    "Endocrine symptoms should be reviewed",
    "MRI protocol and image plane affect reliability",
    "Formal radiology review is needed",
    "Endocrinology referral may be appropriate if suspected",
  ],
  recommendation:
    "If the finding is clinically suspected, discuss the scan with a healthcare professional. Pituitary evaluation may require dedicated MRI review, visual field testing, and hormone blood tests guided by an endocrinologist or specialist.",
  notice:
    "Important: This model cannot determine hormone activity, tumor size category, or the need for treatment.",
};

const tumorDetails = {
  glioma: gliomaDetails,
  meningioma: meningiomaDetails,
  pituitary: pituitaryDetails,
  notumor: noTumorDetails,
  no_tumor: noTumorDetails,
};

const fallbackDetails = {
  insightTitle: "Model Output",
  insightSubtitle: "Class-specific pattern detected by the model",
  description: [
    "The model produced a class label that is not part of the current insight library. Review the confidence scores, image quality, and stored label value before using this result for research interpretation.",
    "This result should still be treated as an AI classification output only. It cannot confirm or rule out disease and must be interpreted with clinical context and professional radiology review.",
  ],
  signsTitle: "Model Interpretation Notes",
  signs: [
    "Stored label does not match a known insight key",
    "Image preprocessing may affect the result",
    "Probability distribution should be reviewed",
    "Model output is not a clinical diagnosis",
    "Radiology interpretation remains required",
    "Clinical history must be considered",
  ],
  recommendation:
    "Ask a qualified healthcare professional to review the MRI and the original radiology report. Use this application result only as research or educational support.",
  notice:
    "Important: CerebraSense is a research and educational prototype, not a diagnostic medical device.",
};

const labelMap = {
  glioma: "Glioma",
  meningioma: "Meningioma",
  notumor: "No Tumor",
  pituitary: "Pituitary",
};

const labelAliases = {
  glioma: "glioma",
  meningioma: "meningioma",
  "no tumor": "notumor",
  no_tumor: "notumor",
  notumor: "notumor",
  pituitary: "pituitary",
};

const classOrder = ["glioma", "meningioma", "notumor", "pituitary"];

const normalizeLabel = (label: string) => {
  const key = String(label ?? "").trim().toLowerCase().replace(/[-\s]+/g, "_");
  return labelAliases[key as keyof typeof labelAliases] ?? key;
};

const formatLabel = (label: string) =>
  labelMap[normalizeLabel(label) as keyof typeof labelMap] ?? label;

const formatDate = (value: string) =>
  new Intl.DateTimeFormat("en", {
    month: "long",
    day: "numeric",
    year: "numeric",
  }).format(new Date(value));

const supabase = createSupabaseAdmin();
const { data: analysisRows, error: analysesError } = await supabase
  .from("tumor_analyses")
  .select("*")
  .order("created_at", { ascending: false });

if (analysesError) {
  console.error("Repository load failed:", analysesError.message);
}

const analyses = await Promise.all(
  ((analysisRows ?? []) as TumorAnalysis[]).map(async (row) => {
    const { data: signedImage } = await supabase.storage
      .from("brain-scans")
      .createSignedUrl(row.image_path, 60 * 60);
    const predictedLabel = row.predicted_label;
    const normalizedLabel = normalizeLabel(predictedLabel);
    const detailKey = normalizedLabel as keyof typeof tumorDetails;
    const details = tumorDetails[detailKey] ?? fallbackDetails;
    const normalizedProbabilities = Object.entries(row.probabilities ?? {}).reduce(
      (scores, [label, value]) => {
        scores[normalizeLabel(label)] = Number(value);
        return scores;
      },
      {} as Record<string, number>,
    );
    const scoreKeys = [
      ...classOrder.filter((label) => label in normalizedProbabilities),
      ...Object.keys(normalizedProbabilities).filter(
        (label) => !classOrder.includes(label),
      ),
    ];

    return {
      id: row.id,
      image: signedImage?.signedUrl ?? "",
      prediction: formatLabel(normalizedLabel),
      confidence: `${Number(row.confidence).toFixed(2)}%`,
      filename: row.original_filename,
      date: formatDate(row.created_at),
      category: formatLabel(normalizedLabel),
      scores: scoreKeys.map((label) => ({
        label: formatLabel(label),
        value: normalizedProbabilities[label].toFixed(2),
        width: Math.max(0, Math.min(100, normalizedProbabilities[label])),
        highlight: label === normalizedLabel,
      })),
      ...details,
    };
  }),
);
---

<Container>
  <Sectionhead>
    <Fragment slot="title">Repository of CerebraSense</Fragment>
    <Fragment slot="desc">
      A collection of saved MRI analysis records from CerebraSense.
    </Fragment>
  </Sectionhead>

  <section class="repository-content">
    <div class="filter-row">
      {filters.map((filter) => (
        <button
          type="button"
          class={filter === "All" ? "active" : ""}
          data-filter={filter}>
          {filter}
        </button>
      ))}
    </div>

    <div class="repository-results">
      <p class="repository-status" data-loading-state>Loading...</p>
      <p class="repository-status" data-empty-state hidden>No records found.</p>

      <div class="analysis-grid" data-analysis-grid>
        {analyses.map((item) => (
          <article class="analysis-card" data-category={item.category}>
            {item.image ? (
              <img src={item.image} alt={`${item.prediction} MRI scan`} />
            ) : (
              <div class="scan-preview" aria-label="MRI scan unavailable"></div>
            )}

            <div class="analysis-card-body">
              <h2>{item.prediction}</h2>
              <p>{item.confidence} confidence</p>
              <p>{item.filename}</p>
              <p>{item.date}</p>
              <button
                type="button"
                class="details-link"
                data-detail-target={item.id}>
                View Details &gt;
              </button>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Container>

<dialog class="analysis-dialog" data-analysis-modal>
  <div class="analysis-dialog-card">
    <button type="button" class="modal-close" data-modal-close>
      Close
    </button>

    {analyses.map((item) => (
      <article class="analysis-detail" data-analysis-detail={item.id} hidden>
        <header class="detail-header">
          <p>Prediction</p>
          <h2>{item.prediction}</h2>
          <span></span>
        </header>

        <div class="detail-layout">
          <figure class="detail-scan">
            {item.image ? (
              <img
                src={item.image}
                alt={`${item.prediction} MRI scan detail`}
              />
            ) : (
              <div
                class="detail-scan-frame"
                aria-label="MRI scan unavailable">
              </div>
            )}
            <figcaption>
              <span>{item.filename}</span>
              <span>{item.date}</span>
            </figcaption>
          </figure>

          <section class="confidence-panel">
            <p class="panel-eyebrow">Confidence Scores</p>
            <div class="score-list">
              {item.scores.map((score) => (
                <div class="score-item">
                  <div class="score-meta">
                    <span>{score.label}</span>
                    <span>{score.value}%</span>
                  </div>
                  <div class="score-track">
                    <span
                      class:list={[
                        "score-fill",
                        score.highlight && "score-fill-highlight",
                      ]}
                      style={`width: ${score.width}%`}>
                    </span>
                  </div>
                </div>
              ))}
            </div>
          </section>
        </div>

        <section class="insight-card">
          <header>
            <p class="panel-eyebrow">Insights</p>
            <h3>{item.insightTitle}</h3>
            <p>{item.insightSubtitle}</p>
          </header>

          <div class="insight-divider"></div>

          <div class="insight-copy">
            <h4>Description</h4>
            {item.description.map((paragraph) => <p>{paragraph}</p>)}
          </div>

          <div class="signs-block">
            <h4>{item.signsTitle}</h4>
            <ul>
              {item.signs.map((sign) => <li>{sign}</li>)}
            </ul>
          </div>

          <div class="insight-copy">
            <h4>Health Recommendations</h4>
            <p>{item.recommendation}</p>
          </div>

          <p class="detail-notice">{item.notice}</p>
        </section>
      </article>
    ))}
  </div>
</dialog>

<script>
  const buttons = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-filter]")
  );
  const cards = Array.from(
    document.querySelectorAll<HTMLElement>("[data-category]")
  );
  const grid = document.querySelector<HTMLElement>("[data-analysis-grid]");
  const loadingState =
    document.querySelector<HTMLElement>("[data-loading-state]");
  const emptyState = document.querySelector<HTMLElement>("[data-empty-state]");
  const detailButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-detail-target]")
  );
  const modal = document.querySelector<HTMLDialogElement>(
    "[data-analysis-modal]"
  );
  const detailPanels = Array.from(
    document.querySelectorAll<HTMLElement>("[data-analysis-detail]")
  );
  const closeButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-modal-close]")
  );

  const setActiveButton = (activeFilter: string) => {
    buttons.forEach((button) => {
      button.classList.toggle(
        "active",
        button.getAttribute("data-filter") === activeFilter
      );
    });
  };

  const renderRepository = (filter = "All") => {
    let visibleCount = 0;

    cards.forEach((card) => {
      const category = card.getAttribute("data-category");
      const shouldShow = filter === "All" || category === filter;

      card.hidden = !shouldShow;

      if (shouldShow) {
        visibleCount += 1;
      }
    });

    if (loadingState) {
      loadingState.hidden = true;
    }

    if (grid) {
      grid.hidden = visibleCount === 0;
    }

    if (emptyState) {
      emptyState.hidden = visibleCount > 0;
      emptyState.textContent =
        cards.length === 0
          ? "No records yet. Past MRI analysis records will appear here once available."
          : `No records found for ${filter}.`;
    }

    setActiveButton(filter);
  };

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      renderRepository(button.getAttribute("data-filter") ?? "All");
    });
  });

  const closeModal = () => {
    modal?.close();
    document.body.style.overflow = "";
    document.documentElement.classList.remove("repository-modal-open");
  };

  detailButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const targetId = button.getAttribute("data-detail-target");

      detailPanels.forEach((panel) => {
        panel.hidden = panel.getAttribute("data-analysis-detail") !== targetId;
      });

      if (modal?.showModal) {
        modal.showModal();
      } else {
        modal?.setAttribute("open", "");
      }

      document.body.style.overflow = "hidden";
      document.documentElement.classList.add("repository-modal-open");
    });
  });

  closeButtons.forEach((button) => {
    button.addEventListener("click", closeModal);
  });

  modal?.addEventListener("click", (event) => {
    if (event.target === modal) {
      closeModal();
    }
  });

  modal?.addEventListener("close", () => {
    document.documentElement.classList.remove("repository-modal-open");
  });

  window.setTimeout(() => renderRepository("All"), 250);
</script>
<style>
  .repository-content {
    color: rgb(71 85 105);
    font-size: 1rem;
    line-height: 1.8;
    margin: 4rem auto 0;
  }

  .filter-row {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .filter-row button {
    border: 1px solid #0f172a;
    border-radius: 999px;
    background: white;
    color: #0f172a;
    padding: 10px 22px;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
  }

  .filter-row button.active,
  .filter-row button:hover {
    background: #0f172a;
    color: white;
  }

  .repository-results {
    min-height: 52vh;
  }

  .repository-status {
    margin: 4rem 0 0;
    text-align: center;
    color: rgb(15 23 42);
    font-size: 1.1rem;
    font-weight: 700;
  }

  .analysis-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
    max-width: 1240px;
    margin: 3rem auto 0;
  }

  .analysis-card {
    display: flex;
    min-height: 330px;
    flex-direction: column;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    overflow: hidden;
    background: white;
    color: rgb(15 23 42);
    box-shadow: 0 18px 45px rgba(15, 23, 42, 0.06);
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease;
  }

  .analysis-card:hover {
    transform: translateY(-3px);
    border-color: rgba(15, 23, 42, 0.22);
    box-shadow: 0 24px 58px rgba(15, 23, 42, 0.12);
  }

  .analysis-card img,
  .scan-preview {
    width: 100%;
    height: 176px;
    object-fit: cover;
    object-position: center;
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
  }

  .scan-preview {
    display: block;
  }

  .analysis-card-body {
    display: flex;
    min-height: 152px;
    flex: 1;
    flex-direction: column;
    padding: 16px;
  }

  .analysis-card h2 {
    margin: 0 0 0.35rem;
    color: rgb(15 23 42);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .analysis-card p {
    margin: 0;
    color: rgb(71 85 105);
    font-size: 0.82rem;
    line-height: 1.55;
  }

  .details-link {
    display: inline-flex;
    align-self: flex-end;
    border: 0;
    background: transparent;
    padding: 0;
    margin-top: auto;
    color: rgb(15 23 42);
    font: inherit;
    font-size: 0.78rem;
    font-weight: 700;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .details-link:hover {
    color: rgb(71 85 105);
  }

  .analysis-dialog {
    position: fixed;
    top: 50%;
    left: 50%;
    width: min(1040px, calc(100vw - 40px));
    max-height: min(88vh, 920px);
    border: 0;
    border-radius: 24px;
    padding: 0;
    margin: 0;
    overflow: auto;
    background: transparent;
    transform: translate(-50%, -50%);
    color: rgb(15 23 42);
  }

  .analysis-dialog::backdrop {
    background: rgba(3, 7, 18, 0.78);
    backdrop-filter: blur(8px);
  }

  .analysis-dialog-card {
    position: relative;
    width: 100%;
    box-sizing: border-box;
    overflow: hidden;
    border: 1px solid #e2e8f0;
    border-radius: 24px;
    background: white;
    box-shadow: 0 28px 90px rgba(15, 23, 42, 0.24);
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
  }

  .modal-close {
    position: absolute;
    top: 20px;
    right: 20px;
    border: 1px solid #0f172a;
    border-radius: 999px;
    background: white;
    color: #0f172a;
    padding: 8px 16px;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
  }

  .modal-close:hover {
    background: #0f172a;
    color: white;
  }

  .detail-header {
    text-align: center;
    margin-bottom: clamp(1.75rem, 4vw, 2.5rem);
  }

  .detail-header p,
  .panel-eyebrow {
    margin: 0;
    color: rgb(71 85 105);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .detail-header h2 {
    margin: 0.35rem 0 0;
    color: rgb(15 23 42);
    font-size: clamp(2.15rem, 5vw, 3.75rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .detail-header span {
    display: block;
    width: 50px;
    height: 2px;
    margin: 1rem auto 0;
    background: rgb(15 23 42);
  }

  .detail-layout {
    display: grid;
    grid-template-columns: minmax(240px, 0.9fr) minmax(320px, 1.1fr);
    gap: clamp(2rem, 6vw, 4.5rem);
    align-items: start;
  }

  .detail-scan {
    margin: 0;
    text-align: center;
  }

  .detail-scan img,
  .detail-scan-frame {
    width: 100%;
    min-height: 280px;
    max-height: 310px;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    object-fit: cover;
    background: #f8fafc;
  }

  .detail-scan-frame {
    display: block;
  }

  .detail-scan figcaption {
    display: grid;
    gap: 0.15rem;
    margin-top: 1rem;
    color: rgb(71 85 105);
    font-size: 0.8rem;
  }

  .confidence-panel {
    padding-top: 0.25rem;
  }

  .score-list {
    display: grid;
    gap: 1.35rem;
    margin-top: 1.5rem;
  }

  .score-meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.5rem;
    color: rgb(15 23 42);
    font-size: 0.95rem;
    font-weight: 600;
  }

  .score-track {
    height: 6px;
    overflow: hidden;
    border-radius: 999px;
    background: #e2e8f0;
  }

  .score-fill {
    display: block;
    height: 100%;
    min-width: 2px;
    border-radius: inherit;
    background: rgb(100 116 139);
  }

  .score-fill-highlight {
    background: rgb(15 23 42);
    box-shadow: 0 0 18px rgba(15, 23, 42, 0.18);
  }

  .insight-card {
    margin: clamp(2rem, 5vw, 3rem) auto 0;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    background: #f8fafc;
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .insight-card header {
    text-align: center;
  }

  .insight-card h3 {
    margin: 1rem 0 0.35rem;
    color: rgb(15 23 42);
    font-size: 1.45rem;
    font-weight: 700;
  }

  .insight-card header p:last-child {
    margin: 0;
    color: rgb(71 85 105);
  }

  .insight-divider {
    height: 1px;
    margin: 1.5rem 0;
    background: #e2e8f0;
  }

  .insight-copy h4,
  .signs-block h4 {
    margin: 0 0 0.85rem;
    color: rgb(15 23 42);
    font-size: 1rem;
    font-weight: 700;
  }

  .insight-copy p {
    margin: 0 0 1rem;
    color: rgb(71 85 105);
    font-size: 0.95rem;
    line-height: 1.8;
  }

  .signs-block {
    margin: 1.5rem 0;
  }

  .signs-block ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.55rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .signs-block li {
    position: relative;
    padding-left: 1rem;
    color: rgb(71 85 105);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .signs-block li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: rgb(15 23 42);
  }

  .detail-notice {
