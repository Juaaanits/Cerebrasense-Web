---
// @ts-ignore
import { Icon } from "astro-icon/components";

const features = [
  {
    title: "EfficientNet-B0 Transfer Learning",
    description:
      "Upgraded from the earlier 32 x 32 CNN to a 224 x 224 image-folder pipeline using EfficientNet-B0, reaching 98.93% test accuracy and 98.89% macro F1.",
    icon: "bx:bxs-brain",
  },
  {
    title: "Calibrated Confidence",
    description:
      "Applies learned temperature scaling and a 70% confidence threshold so low-confidence outputs can be marked as uncertain instead of treated as final.",
    icon: "bx:bxs-thermometer",
  },
  {
    title: "Notebook-to-Web Bundle",
    description:
      "Deploys one bundle containing model weights, class order, display labels, input size, normalization, calibration temperature, and threshold metadata.",
    icon: "bx:bxs-package",
  },
  {
    title: "Four-Class MRI Workflow",
    description:
      "Classifies uploaded MRI images as glioma, meningioma, no tumor, or pituitary and connects each result to class-specific educational insights.",
    icon: "bx:bxs-category",
  },
  {
    title: "Robust Training Controls",
    description:
      "Uses augmentation, duplicate checks, class weighting, label smoothing, and validation macro-F1 model selection to reduce overfitting risk.",
    icon: "bx:bxs-shield",
  },
  {
    title: "Stored Analysis Repository",
    description:
      "Stores uploaded scans, predicted labels, calibrated probabilities, confidence scores, and model versions through Supabase-backed records.",
    icon: "bx:bxs-data",
  },
];
---

<section id="features" class="scroll-mt-20">
  <div class="mt-16 min-w-0 md:mt-0">
    <h2 class="break-words text-3xl font-bold leading-tight sm:text-4xl lg:text-5xl lg:tracking-tight">
      Improved Model Pipeline from Notebook to Web
    </h2>
    <p class="mt-4 max-w-3xl break-words text-base leading-7 text-slate-600 sm:text-lg sm:leading-8">
      The latest CerebraSense version connects the improved training notebook,
      calibrated PyTorch inference service, Supabase persistence, and web result
      interface into one reproducible research workflow.
    </p>
  </div>
</section>

<div class="mt-10 grid min-w-0 gap-8 sm:grid-cols-2 md:mt-16 md:grid-cols-3 md:gap-12 xl:gap-16">
  {
    features.map((item) => (
      <div class="flex min-w-0 gap-4 items-start">
        <div class="mt-1 bg-black rounded-full p-2 w-8 h-8 shrink-0">
          <Icon class="text-white" name={item.icon} />
        </div>
        <div class="min-w-0">
          <h3 class="break-words text-lg font-semibold">{item.title}</h3>{" "}
          <p class="mt-2 break-words leading-relaxed text-slate-500">{item.description}</p>
        </div>
      </div>
    ))
  }
</div>
