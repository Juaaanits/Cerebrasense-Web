---
// @ts-ignore
import { Icon } from "astro-icon/components";

const stack = [
  { name: "Astro 5", icon: "simple-icons:astro" },
  { name: "TypeScript", icon: "simple-icons:typescript" },
  { name: "Tailwind CSS", icon: "simple-icons:tailwindcss" },
  { name: "FastAPI", icon: "simple-icons:fastapi" },
  { name: "Uvicorn", icon: "bx:bxs-server" },
  { name: "Python", icon: "simple-icons:python" },
  { name: "PyTorch", icon: "simple-icons:pytorch" },
  { name: "torchvision", icon: "simple-icons:pytorch" },
  { name: "EfficientNet-B0", icon: "bx:bxs-brain" },
  { name: "Pillow", icon: "bx:bxs-image" },
  { name: "NumPy", icon: "simple-icons:numpy" },
  { name: "scikit-learn", icon: "simple-icons:scikitlearn" },
  { name: "Supabase", icon: "simple-icons:supabase" },
];
---

<div class="mt-24">
  <h2 class="text-center text-slate-500">Current Web and Model Stack</h2>
  <div class="flex gap-3 items-center justify-center mt-10 flex-wrap">
    {
      stack.map((item) => (
        <div class="flex items-center gap-2 rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 shadow-sm">
          <Icon class="size-5 text-slate-900" name={item.icon} title={item.name} />
          <span>{item.name}</span>
        </div>
      ))
    }
  </div>
</div>
