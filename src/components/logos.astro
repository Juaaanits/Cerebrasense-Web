---
// @ts-ignore
import { Icon } from "astro-icon/components";
---

<div class="mt-24">
  <h2 class="text-center text-slate-500">Built with Research-Grade Technologies</h2>
  <div class="flex gap-7 md:gap-14 items-center justify-center mt-10 flex-wrap">

    <!-- Frontend -->
    <Icon class="size-8 md:size-12" name="simple-icons:astro" title="Astro" />
    <Icon class="size-8 md:size-12" name="simple-icons:typescript" title="TypeScript" />
    <Icon class="size-8 md:size-12" name="simple-icons:tailwindcss" title="Tailwind CSS" />

    <!-- Icons & SEO -->
    <Icon class="size-8 md:size-12" name="bx:bxs-cog" title="astro-icon" />
    <Icon class="size-8 md:size-12" name="simple-icons:iconify" title="Iconify" />
    <Icon class="size-8 md:size-12" name="bx:bxs-search" title="astro-seo" />
    <Icon class="size-8 md:size-12" name="bx:bx-sitemap" title="@astrojs/sitemap" />

    <!-- Model Development -->
    <Icon class="size-8 md:size-12" name="simple-icons:python" title="Python" />
    <Icon class="size-8 md:size-12" name="simple-icons:numpy" title="NumPy" />
    <Icon class="size-8 md:size-12" name="simple-icons:pytorch" title="PyTorch" />
    <Icon class="size-8 md:size-12" name="simple-icons:scikitlearn" title="scikit-learn" />

    <!-- Mobile & Deployment -->
    <Icon class="size-8 md:size-12" name="simple-icons:react" title="React Native" />
    <Icon class="size-8 md:size-12" name="simple-icons:expo" title="Expo" />
    <Icon class="size-8 md:size-12" name="simple-icons:fastapi" title="FastAPI" />
    <Icon class="size-8 md:size-12" name="simple-icons:supabase" title="Supabase" />
    <Icon class="size-8 md:size-12" name="bx:bxs-chip" title="ExecuTorch" />

  </div>
</div>
