---
import Link from "./ui/link.astro";
// @ts-ignore
import { Icon } from "astro-icon/components";
---

<div
  class="mx-auto mt-16 flex max-w-5xl flex-col items-center rounded-lg bg-black p-6 text-center sm:p-8 md:mt-20 md:px-20 md:py-20">
  <h2 class="break-words text-3xl leading-tight text-white sm:text-4xl md:text-6xl md:tracking-tight">
    Test the Improved MRI Classifier.
  </h2>
  <p class="mt-4 max-w-3xl break-words text-base leading-7 text-slate-400 sm:text-lg md:text-xl">
    The deployed EfficientNet-B0 model reached 98.93% test accuracy and 98.89%
    macro F1 in the latest notebook run, with calibrated confidence scores and
    uncertainty handling added to the web result flow.
  </p>
  <div class="mt-8 flex w-full flex-col gap-3 sm:w-auto sm:flex-row sm:gap-5 md:mt-10">
    <!-- Main Action: Goes to the upload demo -->
    <Link href="/demo" style="inverted" class="flex w-full items-center justify-center gap-2 text-sm font-semibold sm:w-auto sm:text-base">
      <Icon class="h-4 w-4 shrink-0 text-current sm:h-5 sm:w-5" name="bx:bxs-brain" title="CerebraSense Demo" />
      Open Demo
    </Link>
    
    <!-- Secondary Action: Goes to Development Docs -->
    <Link 
      href="/development" 
      size="lg" 
      style="muted" 
      class="flex w-full items-center justify-center gap-2 text-sm font-semibold sm:w-auto sm:text-base"
      rel="noopener">
      <Icon class="h-4 w-4 shrink-0 text-current" name="bx:bxs-book-open" title="Development Docs" />
      View Development Docs
    </Link>
  </div>
  <p class="mt-6 text-sm italic text-slate-500">
    Research and educational prototype only. Not for clinical diagnosis.
  </p>
</div>
