---
import Link from "./ui/link.astro";
// @ts-ignore
import { Icon } from "astro-icon/components";
---

<div
  class="bg-black p-8 md:px-20 md:py-20 mt-20 mx-auto max-w-5xl rounded-lg flex flex-col items-center text-center">
  <h2 class="text-white text-4xl md:text-6xl tracking-tight">
    Experience Intelligent MRI Analysis.
  </h2>
  <p class="text-slate-400 mt-4 text-lg md:text-xl">
    CerebraSense provides automated, internally validated classification of brain 
    tumor types with 97.33% accuracy. Upload an MRI slice to see the decision 
    support system in action.
  </p>
  <div class="flex flex-col sm:flex-row gap-5 mt-10">
    <!-- Main Action: Goes to the upload demo -->
    <Link href="/demo" style="inverted" class="flex gap-1 items-center justify-center">
      <Icon class="h-5 w-5 shrink-0 text-current" name="bx:bxs-brain" title="CerebraSense Demo" />
      Launch Interactive Demo
    </Link>
    
    <!-- Secondary Action: Goes to Development Docs -->
    <Link 
      href="/development" 
      size="lg" 
      style="muted" 
      class="flex gap-1 items-center justify-center" 
      rel="noopener">
      <Icon class="h-4 w-4 shrink-0 text-current" name="bx:bxl-github" title="GitHub" />
      View Methodology
    </Link>
  </div>
  <p class="text-slate-500 mt-6 text-sm italic">
    Note: For research and internal evaluation purposes only. Not for clinical diagnosis.
  </p>
</div>
