---
import Link from "@/components/ui/link.astro";
import { Icon } from "astro-icon/components";

const splashImage = "/mobile-splash.png";
const libraryImage = "/mobile-library.png";
---

<main
  class="grid w-full min-w-0 items-center gap-10 overflow-hidden pt-10 pb-8 md:pt-12 md:pb-20 lg:grid-cols-2 lg:gap-12">
  <div class="hidden w-full min-w-0 py-6 md:order-1 md:block">
    <div class="relative mx-auto flex items-end justify-center gap-4 xl:gap-6">
      <div class="relative h-[430px] w-[206px] rounded-[2.25rem] border-[6px] border-white bg-neutral-950 p-2.5 shadow-2xl xl:h-[500px] xl:w-[240px] xl:rounded-[2.7rem] xl:border-[7px] xl:p-3">
        <div class="absolute left-1/2 top-2.5 h-5 w-24 -translate-x-1/2 rounded-full bg-neutral-900 xl:top-3 xl:h-6 xl:w-28"></div>
        <img
          src={splashImage}
          alt="Mobile app splash screen"
          class="h-full w-full rounded-[1.75rem] object-cover xl:rounded-[2.2rem]" />
      </div>

      <div class="relative h-[430px] w-[206px] rounded-[2.25rem] border-[6px] border-white bg-neutral-950 p-2.5 shadow-2xl xl:h-[500px] xl:w-[240px] xl:rounded-[2.7rem] xl:border-[7px] xl:p-3">
        <div class="absolute left-1/2 top-2.5 h-5 w-24 -translate-x-1/2 rounded-full bg-neutral-900 xl:top-3 xl:h-6 xl:w-28"></div>
        <img
          src={libraryImage}
          alt="Mobile app repository screen"
          class="h-full w-full rounded-[1.75rem] object-cover xl:rounded-[2.2rem]" />
      </div>
    </div>
  </div>
  <div class="w-full min-w-0 max-w-2xl">
    <h1 class="max-w-3xl break-words text-3xl font-bold leading-[1.08] sm:text-4xl md:text-5xl lg:text-6xl xl:text-7xl lg:tracking-tight">
      Deep Learning MRI Analysis, Powered by CerebraSense
    </h1>
    <p class="mt-4 max-w-xl break-words text-base leading-7 text-slate-600 sm:text-lg sm:leading-8">
      CerebraSense now uses the improved notebook pipeline: an EfficientNet-B0
      transfer-learning model trained from MRI image folders with 224 x 224 RGB
      preprocessing, augmentation, macro-F1 checkpointing, confidence
      calibration, and uncertainty handling across glioma, meningioma, no tumor,
      and pituitary classes.
    </p>
    <div class="mt-6 flex flex-col gap-3 sm:flex-row">
      <Link
        href="/demo"
        class="flex w-full items-center justify-center gap-2 text-sm font-semibold sm:w-auto sm:text-base"
        rel="noopener">
        <Icon class="h-4 w-4 shrink-0 text-white sm:h-5 sm:w-5" name="bx:bxs-brain" />

        Analyze MRI
      </Link>
      <Link
        size="lg"
        style="outline"
        rel="noopener"
        href="/development"
        class="flex w-full items-center justify-center gap-2 text-sm font-semibold sm:w-auto sm:text-base"
      >
        <Icon class="h-4 w-4 shrink-0 text-black" name="bx:bxs-book-open" />
        Development Docs
      </Link>
    </div>
  </div>
</main>
