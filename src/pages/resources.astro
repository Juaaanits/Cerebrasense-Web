---
import { Icon } from "astro-icon/components";
import Layout from "@/layouts/Layout.astro";

const resources = [
  {
    title: "Development Overview",
    label: "Available",
    description:
      "Read the technical summary of the dataset, preprocessing pipeline, model architecture, training setup, and evaluation results.",
    href: "/development",
    action: "Open overview",
  },
  {
    title: "GitHub Repository",
    label: "Available",
    description:
      "Source code for the Astro web app, Supabase integration, API routes, and local FastAPI model service.",
    href: "https://github.com/Juaaanits/Cerebrasense-Web",
    action: "Open repository",
  },
  {
    title: "Runtime Services",
    label: "Local",
    description:
      "The web app runs on Astro, while PyTorch inference runs through FastAPI at localhost:8000 during development.",
    action: "Configured locally",
  },
  {
    title: "Data Storage",
    label: "Supabase",
    description:
      "Uploaded MRI files are stored in the private brain-scans bucket, and prediction records are saved in tumor_analyses.",
    action: "Configured in SQL",
  },
];

const techCategories = [
  {
    title: "Web Application",
    icon: "bx:bxs-cog",
    items: [
      { name: "Astro 5", icon: "simple-icons:astro" },
      { name: "@astrojs/node", icon: "simple-icons:nodedotjs" },
      { name: "TypeScript", icon: "simple-icons:typescript" },
      { name: "Tailwind CSS", icon: "simple-icons:tailwindcss" },
    ],
  },
  {
    title: "Supabase Backend",
    icon: "simple-icons:supabase",
    items: [
      { name: "supabase-js", icon: "simple-icons:supabase" },
      { name: "Postgres", icon: "simple-icons:postgresql" },
      { name: "Storage Bucket", icon: "bx:bxs-folder" },
      { name: "RLS Policies", icon: "bx:bxs-lock" },
    ],
  },
  {
    title: "Model Service",
    icon: "bx:bxs-brain",
    items: [
      { name: "FastAPI", icon: "simple-icons:fastapi" },
      { name: "Python", icon: "simple-icons:python" },
      { name: "PyTorch", icon: "simple-icons:pytorch" },
      { name: "torchvision", icon: "simple-icons:pytorch" },
    ],
  },
  {
    title: "ML Utilities",
    icon: "bx:bxs-chip",
    items: [
      { name: "NumPy", icon: "simple-icons:numpy" },
      { name: "scikit-learn", icon: "simple-icons:scikitlearn" },
      { name: "Pillow", icon: "bx:bxs-image" },
      { name: "python-multipart", icon: "bx:bxs-file" },
    ],
  },
  {
    title: "UI & SEO",
    icon: "bx:bxs-search",
    items: [
      { name: "astro-icon", icon: "bx:bxs-cog" },
      { name: "Iconify", icon: "simple-icons:iconify" },
      { name: "astro-seo", icon: "bx:bxs-search" },
      { name: "@astrojs/sitemap", icon: "bx:bx-sitemap" },
    ],
  },
];
---

<Layout title="Resources">
  <main class="resources-page">
    <section class="resources-hero">
      <p class="eyebrow">Resources</p>
      <h1>Project References & Setup Notes</h1>
      <p>
        Technical links, local setup commands, and supporting project notes for
        CerebraSense.
      </p>
    </section>

    <section class="resource-grid" aria-label="Project resources">
      {
        resources.map((item) => (
          <article class="resource-card">
            <div class="card-topline">
              <span class="status-badge">{item.label}</span>
            </div>
            <h2>{item.title}</h2>
            <p>{item.description}</p>
            {
              item.href ? (
                <a class="resource-action" href={item.href}>
                  {item.action}
                </a>
              ) : (
                <span class="resource-action muted">{item.action}</span>
              )
            }
          </article>
        ))
      }
    </section>

    <section class="setup-section">
      <div class="section-copy">
        <p class="eyebrow">Local Setup</p>
        <h2>Run The Full Stack</h2>
        <p>
          Run the FastAPI model service and Astro app in separate terminals.
          The web app reads Supabase credentials from <code>.env</code> or
          <code>.env.local</code>, then sends scan uploads to
          <code>MODEL_API_URL</code>.
        </p>
      </div>

      <div class="terminal-card" aria-label="Local setup commands">
        <div class="terminal-bar">
          <span></span>
          <span></span>
          <span></span>
        </div>
        <pre><code># Terminal 1: model service
cd model-service
pip install -r requirements.txt
uvicorn app.main:app --reload --port 8000

# Terminal 2: Astro app
cd ..
npm install
npm run dev

# Local URLs
http://localhost:4321/demo
http://localhost:4321/repository

# Verification
npm run build
curl http://127.0.0.1:8000/health</code></pre>
      </div>
    </section>

    <section class="environment-section">
      <article class="reference-card">
        <p class="eyebrow">Configuration</p>
        <h2>Environment Variables</h2>
        <p>
          Keep secrets local. These values are required for upload, analysis,
          private image storage, and repository records.
        </p>
        <pre><code>PUBLIC_SUPABASE_URL=your_supabase_project_url
PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SECRET_KEY=your_service_role_or_secret_key
MODEL_API_URL=http://127.0.0.1:8000
MODEL_API_TOKEN=dev-secret-token</code></pre>
      </article>

      <article class="reference-card">
        <p class="eyebrow">Data Flow</p>
        <h2>Analysis Pipeline</h2>
        <ol class="flow-list">
          <li>Upload a JPEG or PNG MRI from <code>/demo</code>.</li>
          <li><code>/api/analyze</code> stores the image in Supabase Storage.</li>
          <li>The API route forwards the image to FastAPI <code>/predict</code>.</li>
          <li>FastAPI loads the PyTorch model and returns probabilities.</li>
          <li>The result is inserted into <code>tumor_analyses</code>.</li>
          <li><code>/repository</code> renders saved records from Supabase.</li>
        </ol>
      </article>
    </section>

    <section class="reference-grid">
      <article class="reference-card">
        <p class="eyebrow">Codebase</p>
        <h2>Project Structure</h2>
        <div class="file-browser">
          <div class="browser-bar">
            <span></span>
            <span></span>
            <span></span>
            <code>cerebrasense-web/</code>
          </div>

          <div class="file-tree">
            <details open>
              <summary>
                <Icon class="tree-icon" name="bx:bxs-folder-open" />
                <span>src</span>
                <span class="tree-badge">6 items</span>
              </summary>
              <div class="tree-children">
                <div class="tree-row">
                  <Icon class="tree-icon" name="bx:bxs-folder" />
                  <span>components</span>
                </div>
                <div class="tree-row">
                  <Icon class="tree-icon" name="bx:bxs-folder" />
                  <span>layouts</span>
                </div>
                <div class="tree-row">
                  <Icon class="tree-icon" name="bx:bxs-folder" />
                  <span>lib/supabase</span>
                </div>
                <div class="tree-row">
                  <Icon class="tree-icon" name="bx:bxs-folder" />
                  <span>pages/api</span>
                </div>
                <div class="tree-row">
                  <Icon class="tree-icon" name="bx:bxs-folder" />
                  <span>pages</span>
                </div>
                <div class="tree-row">
                  <Icon class="tree-icon" name="bx:bxs-folder" />
                  <span>styles</span>
                </div>
              </div>
            </details>

            <details>
              <summary>
                <Icon class="tree-icon" name="bx:bxs-folder" />
                <span>model-service</span>
              </summary>
              <div class="tree-children">
                <div class="tree-row">
                  <Icon class="tree-icon" name="bx:bxs-folder" />
                  <span>app</span>
                </div>
                <div class="tree-row">
                  <Icon class="tree-icon" name="bx:bxs-folder" />
                  <span>models</span>
                </div>
                <div class="tree-row">
                  <Icon class="tree-icon" name="bx:bxs-file" />
                  <span>requirements.txt</span>
                </div>
              </div>
            </details>

            <details>
              <summary>
                <Icon class="tree-icon" name="bx:bxs-folder" />
                <span>supabase</span>
              </summary>
              <div class="tree-children">
                <div class="tree-row">
                  <Icon class="tree-icon" name="bx:bxs-file" />
                  <span>schema.sql</span>
                </div>
              </div>
            </details>

            <details>
              <summary>
                <Icon class="tree-icon" name="bx:bxs-folder" />
                <span>public</span>
              </summary>
              <div class="tree-children">
                <div class="tree-row muted-row">
                  <Icon class="tree-icon" name="bx:bxs-file" />
                  <span>static assets</span>
                </div>
              </div>
            </details>

            <div class="tree-row">
              <Icon class="tree-icon file-json" name="bx:bxs-file-json" />
              <span>package.json</span>
            </div>
            <div class="tree-row">
              <Icon class="tree-icon file-config" name="bx:bxs-cog" />
              <span>astro.config.mjs</span>
            </div>
          </div>
        </div>
      </article>

      <article class="reference-card">
        <p class="eyebrow">Stack</p>
        <h2>Tech Stack</h2>
        <div class="stack-grid">
          {
            techCategories.map((category, index) => (
              <details class="stack-card" open={index === 0}>
                <summary class="stack-heading">
                  <span>{category.title}</span>
                  <span class="stack-count">{category.items.length} tools</span>
                </summary>
                <div class="stack-tags">
                  {category.items.map((item) => (
                    <span class="stack-tag">
                      <Icon class="stack-icon" name={item.icon} />
                      {item.name}
                    </span>
                  ))}
                </div>
              </details>
            ))
          }
        </div>
      </article>
    </section>

    <section class="bottom-card-grid">
      <section class="developer-card">
        <img
          class="developer-photo"
          src="/profile.png"
          alt="Portrait of Juanito M. Ramos II"
          loading="lazy"
        />
        <div class="developer-content">
          <p class="eyebrow">Developer</p>
          <h2>Juanito M. Ramos II</h2>
          <p>
            CerebraSense was designed, developed, and organized end-to-end by
            Juanito, covering the web interface, project structure,
            documentation, and machine learning development workflow.
          </p>
          <div class="developer-actions">
            <a class="developer-link" href="#">
              <Icon class="button-icon" name="simple-icons:linkedin" />
              LinkedIn
            </a>
            <a class="developer-link secondary" href="#">
              <Icon class="button-icon" name="simple-icons:github" />
              GitHub
            </a>
          </div>
        </div>
      </section>

      <section class="disclaimer-card">
        <div class="note-icon-wrap" aria-hidden="true">
          <Icon class="note-icon" name="bx:bxs-info-circle" />
        </div>
        <div class="disclaimer-content">
          <p class="eyebrow">Important Note</p>
          <h2>Research Prototype Disclaimer</h2>
          <p>
            CerebraSense is a research and educational prototype. It is not
            intended for clinical diagnosis without external validation,
            regulatory review, and professional medical oversight.
          </p>
        </div>
      </section>
    </section>
  </main>
</Layout>

<style>
  .resources-page {
    --ink: #0f172a;
    --muted: #475569;
    --line: #e2e8f0;
    --soft: #f8fafc;
    --accent: #111827;
    --accent-dark: #0f172a;
    --warning: #0f172a;
    max-width: 1200px;
    margin: 0 auto;
    padding: 72px 24px 96px;
  }

  .resources-hero {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 32px;
    background:
      radial-gradient(circle at 18% 20%, rgba(15, 23, 42, 0.08), transparent 30%),
      linear-gradient(135deg, #ffffff 0%, #f8fafc 52%, #f1f5f9 100%);
    padding: 64px 48px;
    text-align: center;
  }

  .resources-hero::after {
    content: "";
    position: absolute;
    right: -80px;
    bottom: -100px;
    width: 260px;
    height: 260px;
    border: 34px solid rgba(15, 23, 42, 0.06);
    border-radius: 999px;
  }

  .eyebrow {
    color: var(--accent-dark);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    margin: 0 0 14px;
    text-transform: uppercase;
  }

  .resources-hero h1,
  .section-copy h2,
  .reference-card h2,
  .developer-card h2,
  .disclaimer-card h2 {
    color: var(--ink);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.05;
    margin: 0;
  }

  .resources-hero h1 {
    font-size: clamp(2.5rem, 6vw, 5.5rem);
  }

  .resources-hero p:last-child {
    color: var(--muted);
    font-size: 1.2rem;
    line-height: 1.7;
    margin: 22px auto 0;
    max-width: 760px;
  }

  .resource-grid {
    display: grid;
    gap: 24px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 48px;
  }

  .resource-card,
  .reference-card,
  .developer-card,
  .disclaimer-card {
    border: 1px solid var(--line);
    border-radius: 26px;
    background: #ffffff;
    box-shadow: 0 18px 45px rgba(15, 23, 42, 0.05);
  }

  .resource-card {
    display: flex;
    flex-direction: column;
    min-height: 250px;
    padding: 28px;
  }

  .resource-card:hover {
    border-color: rgba(15, 23, 42, 0.38);
    transform: translateY(-3px);
    transition: 180ms ease;
  }

  .card-topline {
    display: flex;
    justify-content: flex-end;
    min-height: 28px;
  }

  .status-badge {
    border-radius: 999px;
    background: #f1f5f9;
    color: var(--accent-dark);
    font-size: 0.75rem;
    font-weight: 800;
    padding: 6px 10px;
    text-transform: uppercase;
  }

  .resource-card h2 {
    color: var(--ink);
    font-size: 1.55rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 12px 0 0;
  }

  .resource-card p,
  .section-copy p,
  .disclaimer-card p {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.75;
  }

  .resource-card p {
    margin: 16px 0 24px;
  }

  .resource-action {
    align-items: center;
    align-self: flex-start;
    background: var(--ink);
    border-radius: 12px;
    color: #ffffff;
    display: inline-flex;
    font-weight: 800;
    justify-content: center;
    margin-top: auto;
    min-height: 44px;
    padding: 0 18px;
    text-decoration: none;
  }

  .resource-action.muted {
    background: #f1f5f9;
    color: #334155;
  }

  .setup-section {
    align-items: center;
    display: grid;
    gap: 36px;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    margin-top: 72px;
  }

  .section-copy h2,
  .reference-card h2,
  .developer-card h2,
  .disclaimer-card h2 {
    font-size: clamp(2rem, 4vw, 3.1rem);
  }

  .section-copy p {
    margin: 18px 0 0;
  }

  code {
    border-radius: 6px;
    background: #e8eef4;
    color: var(--ink);
    padding: 2px 6px;
  }

  .terminal-card {
    overflow: hidden;
    border: 1px solid rgba(15, 23, 42, 0.18);
    border-radius: 28px;
    background: #0b0f16;
    box-shadow: 0 24px 70px rgba(15, 23, 42, 0.2);
  }

  .terminal-bar {
    display: flex;
    gap: 8px;
    border-bottom: 1px solid rgba(148, 163, 184, 0.18);
    padding: 16px 20px;
  }

  .terminal-bar span {
    width: 11px;
    height: 11px;
    border-radius: 999px;
    background: #f8fafc;
  }

  .terminal-bar span:nth-child(2) {
    background: #94a3b8;
  }

  .terminal-bar span:nth-child(3) {
    background: #334155;
  }

  .terminal-card pre,
  .reference-card pre {
    margin: 0;
    overflow-x: auto;
    white-space: pre;
  }

  .terminal-card pre {
    color: #e5e7eb;
    font-size: 0.95rem;
    line-height: 1.8;
    padding: 26px;
  }

  .terminal-card code,
  .reference-card code {
    background: transparent;
    color: inherit;
    padding: 0;
  }

  .reference-grid {
    display: grid;
    gap: 24px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 72px;
  }

  .environment-section {
    display: grid;
    gap: 24px;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    margin-top: 72px;
  }

  .reference-card {
    padding: 30px;
  }

  .reference-card h2 {
    font-size: clamp(1.7rem, 3vw, 2.3rem);
  }

  .reference-card > p:not(.eyebrow) {
    color: var(--muted);
    line-height: 1.75;
    margin: 16px 0 0;
  }

  .reference-card pre {
    border: 1px solid var(--line);
    border-radius: 16px;
    background: #0b0f16;
    color: #e5e7eb;
    font-size: 0.9rem;
    line-height: 1.75;
    margin-top: 20px;
    padding: 20px;
  }

  .flow-list {
    display: grid;
    gap: 12px;
    margin: 20px 0 0;
    padding-left: 1.25rem;
  }

  .flow-list li {
    color: var(--muted);
    line-height: 1.65;
    padding-left: 0.25rem;
  }

  .file-browser {
    border: 1px solid var(--line);
    border-radius: 18px;
    background: #ffffff;
    margin-top: 24px;
    overflow: hidden;
  }

  .browser-bar {
    align-items: center;
    background: var(--soft);
    border-bottom: 1px solid var(--line);
    display: flex;
    gap: 8px;
    padding: 12px 16px;
  }

  .browser-bar span {
    background: #cbd5e1;
    border-radius: 999px;
    height: 9px;
    width: 9px;
  }

  .browser-bar code {
    background: transparent;
    color: var(--muted);
    font-size: 0.82rem;
    margin-left: 8px;
    padding: 0;
  }

  .file-tree {
    display: grid;
    gap: 4px;
    padding: 14px;
  }

  .file-tree details {
    border-radius: 10px;
  }

  .file-tree summary,
  .tree-row {
    align-items: center;
    border-radius: 10px;
    color: var(--muted);
    display: flex;
    font-size: 0.92rem;
    gap: 9px;
    min-height: 34px;
    padding: 0 10px;
  }

  .file-tree summary {
    cursor: pointer;
    list-style: none;
  }

  .file-tree summary::-webkit-details-marker {
    display: none;
  }

  .file-tree summary:hover,
  .tree-row:hover {
    background: var(--soft);
    color: var(--ink);
  }

  .tree-children {
    border-left: 1px solid var(--line);
    display: grid;
    margin-left: 19px;
    padding-left: 10px;
  }

  .tree-icon {
    color: var(--ink);
    flex: 0 0 16px;
    height: 16px;
    width: 16px;
  }

  .file-json,
  .file-config {
    color: var(--muted);
  }

  .tree-badge {
    background: var(--soft);
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink);
    font-size: 0.68rem;
    font-weight: 800;
    margin-left: 4px;
    padding: 2px 7px;
  }

  .muted-row {
    color: #64748b;
  }

  .stack-grid {
    display: grid;
    gap: 10px;
    margin-top: 24px;
  }

  .stack-card {
    border: 1px solid var(--line);
    border-radius: 14px;
    background: #ffffff;
    padding: 0;
  }

  .stack-heading {
    align-items: center;
    color: var(--ink);
    display: flex;
    font-size: 0.98rem;
    font-weight: 900;
    justify-content: space-between;
    letter-spacing: -0.02em;
    list-style: none;
    min-height: 48px;
    padding: 0 14px;
    text-transform: none;
  }

  .stack-heading::-webkit-details-marker {
    display: none;
  }

  .stack-heading::after {
    color: var(--muted);
    content: "+";
    font-size: 1.1rem;
    font-weight: 800;
    margin-left: 12px;
  }

  .stack-card[open] .stack-heading::after {
    content: "-";
  }

  .stack-count {
    background: var(--soft);
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 800;
    margin-left: auto;
    padding: 3px 8px;
  }

  .stack-tags {
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    gap: 12px 14px;
    padding: 14px;
  }

  .stack-tag {
    align-items: center;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 999px;
    color: var(--ink);
    display: inline-flex;
    font-size: 0.9rem;
    font-weight: 650;
    gap: 7px;
    min-height: 36px;
    padding: 0 13px;
  }

  .stack-icon {
    color: var(--muted);
    height: 14px;
    width: 14px;
  }

  .bottom-card-grid {
    align-items: stretch;
    display: grid;
    gap: 24px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 72px;
  }

  .developer-card {
    display: grid;
    gap: 22px;
    grid-template-columns: auto minmax(0, 1fr);
    margin: 0;
    min-height: 100%;
    padding: 28px;
  }

  .disclaimer-card {
    background:
      linear-gradient(135deg, rgba(248, 250, 252, 0.94), rgba(255, 255, 255, 0.98)),
      #ffffff;
    display: grid;
    gap: 22px;
    grid-template-columns: auto minmax(0, 1fr);
    margin-top: 0;
    min-height: 100%;
    padding: 28px;
  }

  .developer-card h2 {
    color: var(--ink);
    font-size: clamp(1.35rem, 2.2vw, 1.65rem);
    letter-spacing: -0.03em;
    line-height: 1.12;
  }

  .developer-card .eyebrow,
  .disclaimer-card .eyebrow {
    color: var(--accent-dark);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    margin-bottom: 8px;
  }

  .developer-photo,
  .note-icon-wrap {
    border: 1px solid var(--line);
    border-radius: 999px;
