---
import Contactform from "@/components/contactform.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import Layout from "@/layouts/Layout.astro";
import { Icon } from "astro-icon/components";
---

<Layout title="Contact">
  <Container>
    <Sectionhead>
      <Fragment slot="title">CerebraSense</Fragment>
      <Fragment slot="desc">Deep Learning for Multiclass MRI Classification.</Fragment>
    </Sectionhead>

    <div class="grid md:grid-cols-2 gap-10 mx-auto max-w-4xl mt-16">
      <div>
        <h2 class="font-medium text-2xl text-gray-800">Technical Support & Collaboration</h2>
        <p class="text-lg leading-relaxed text-slate-500 mt-3">
         Developing lightweight, well-regularized CNN architectures to support decision-making in neuro-oncology.
        </p>
        <div class="mt-5">
          <div class="flex items-center mt-2 space-x-2 text-gray-600">
            <Icon class="text-gray-400 w-4 h-4" name="uil:map-marker" />
            <span>Quezon City, Philippines</span>
          </div><div class="flex items-center mt-2 space-x-2 text-gray-600">
            <Icon class="text-gray-400 w-4 h-4" name="uil:envelope" /><a
              href="juanitoramos113@gmail.com"
              >juanitoramos113@gmail.com</a
            >
          </div><div class="flex items-center mt-2 space-x-2 text-gray-600">
  <Icon class="text-gray-400 w-4 h-4" name="uil:phone" />
  <a href="tel:+639617516388">+63 961 751 6388</a>
</div>
        </div>
      </div>
      <div>
        <Contactform />
      </div>
    </div>
  </Container>
</Layout>
